# ==============================================================================
# CampusNode — Centralized Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env in the repository root:
#   cp .env.example .env
#
# DO NOT commit real secrets, API keys, or production passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & NETWORK PORT CONFIGURATION
# ------------------------------------------------------------------------------
# Public HTTP port bound on the host server (default: 80 for production)
# For local testing, change to 8080 if port 80 is occupied by another service.
APP_PORT=80
APP_PORT_HTTPS=443

# Node.js backend environment (development | staging | production)
NODE_ENV=production

# Internal Express port (keep as 5000 inside container)
PORT=5000

# Primary public frontend URL used for CORS validation and email verification links
# Local testing: http://localhost (or http://localhost:8080)
# Production   : https://campusnode.nitj.ac.in
CLIENT_URL=http://localhost

# Whitelisted origins for CORS (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Database name, credentials, and internal connection
POSTGRES_DB=campusnode
POSTGRES_USER=campusnode_user
POSTGRES_PASSWORD=ReplaceWithStrongPostgresPassword123#

# Prisma Database Connection String
# For containerized PostgreSQL, target host 'postgres' with explicit sslmode=disable
DATABASE_URL=postgresql://campusnode_user:ReplaceWithStrongPostgresPassword123#@postgres:5432/campusnode?sslmode=disable

# ------------------------------------------------------------------------------
# 3. REDIS CACHE & BULLMQ QUEUE CONFIGURATION
# ------------------------------------------------------------------------------
# Redis authentication password (internal-only network)
REDIS_PASSWORD=ReplaceWithStrongRedisPassword123#

# Full Redis connection string used by Express and BullMQ
REDIS_URL=redis://:ReplaceWithStrongRedisPassword123#@redis:6379

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------------------------------------------
# High-entropy JWT signing secret (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_64_byte_random_hex_string_do_not_use_in_production

# Initial Super-Administrator account seeded into the database via: ./campusnode.sh seed
ADMIN_EMAIL=admin@nitj.ac.in
ADMIN_PASS=ReplaceWithStrongAdminPassword123#
COMMON_PASSWORD=ReplaceWithStrongCommonPassword123#

# ------------------------------------------------------------------------------
# 5. ASYMMETRIC Ed25519 QR TICKET SIGNING (100% Offline Cryptography)
# ------------------------------------------------------------------------------
# Key Identifier for ticket rotation tracking
QR_SIGNING_KEY_ID=cn-qr-nitj-2026-01

# Ed25519 Keypair PEM strings (Generate with: node server/scripts/generate-staging-secrets.js)
QR_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEI...\n-----END PRIVATE KEY-----"
QR_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA...\n-----END PUBLIC KEY-----"

# ------------------------------------------------------------------------------
# 6. EXTERNAL INTEGRATIONS & THIRD-PARTY SERVICES
# ------------------------------------------------------------------------------
# Transactional Email Gateway (SMTP via Nodemailer)
# Local development (Mailpit): localhost:1025 (Web UI: http://localhost:8025)
# Production (College SMTP)  : smtp.nitj.ac.in:587
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CampusNode <no-reply@campusnode.nitj.ac.in>
EMAIL_FROM_NAME=CampusNode Support

# Cloudinary Media Storage (for event banners, club logos, certificates)
# Leave blank during initial local testing; configure for photo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=campusnode/production

# Web Push (VAPID) Notifications (Optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@campusnode.nitj.ac.in

# OpenRouter AI Analysis (Optional, for event feedback sentiment analysis)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ------------------------------------------------------------------------------
# 7. MAINTENANCE & RUNTIME FLAGS
# ------------------------------------------------------------------------------
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="CampusNode is currently undergoing scheduled maintenance."

# ------------------------------------------------------------------------------
# 8. PRODUCTION DOCKER REGISTRY & VERSIONING
# ------------------------------------------------------------------------------
# Used by compose.production.yaml to pull approved images from GitHub Container Registry
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=campusnode
FRONTEND_IMAGE=ghcr.io/campusnode/frontend
BACKEND_IMAGE=ghcr.io/campusnode/backend
IMAGE_TAG=1.3.0
