generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminRole {
  id                String         @id @db.VarChar(24)
  name              String
  email             String         @unique
  password          String
  role              AdminRoleType  @default(admin)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  otp               String?
  otpExpire         DateTime?
  isTwoStepEnabled  Boolean        @default(false)
  resetPasswordExpire DateTime?
  resetPasswordToken  String?
  passwordChangeCount Int          @default(0)
  lastPasswordChangeDate DateTime?
  profileImage      String?
  coordinatedClubs  Club[]         @relation("ClubFacultyCoordinator")
  reviewedEvents    Event[]        @relation("EventReviewedBy")
  sentNotifications Notification[] @relation("NotificationSenderAdmin")
}

model StudentUser {
  id                      String           @id @db.VarChar(24)
  rollNo                  String?          @unique
  name                    String
  email                   String           @unique
  password                String
  branch                  String?
  program                 String?
  expectedGraduationYear  Int?
  academicStatus          String           @default("ACTIVE")
  githubProfile           String?
  linkedinProfile         String?
  xProfile                String?
  instagramProfile        String?
  whatsappNumber          String?
  portfolioUrl            String?
  profileImage            String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  isTwoStepEnabled        Boolean          @default(false)
  isVerified              Boolean          @default(false)
  otp                     String?
  otpExpire               DateTime?
  resetPasswordExpire     DateTime?
  resetPasswordToken      String?
  verificationToken       String?
  verificationTokenExpire DateTime?
  passwordChangeCount     Int              @default(0)
  lastPasswordChangeDate  DateTime?
  isBlocked               Boolean          @default(false)
  accessLevel             String           @default("normal")
  shopBlockedUntil        DateTime?
  lostFoundPostCount      Int              @default(0)
  lastLostFoundPostDate   DateTime?
  memberships             ClubMembership[]
  createdEvents           Event[]          @relation("EventCreatedBy")
  centralOrganizerEvents  Event[]          @relation("CentralOrganizerEvents")
  sentNotifications       Notification[]   @relation("NotificationSenderStudent")
  receivedNotifications   Notification[]   @relation("NotificationRecipientStudent")
  participations          Participation[]
  lostFoundItems          LostFoundItem[]
  lostFoundReports        LostFoundReport[] @relation("ReportReporter")
  lostFoundReportsAgainst LostFoundReport[] @relation("ReportLiar")
  ledTeams                Team[]            @relation("TeamLeader")
  teamMemberships         TeamMember[]
  eventStaffAssignments   EventStaff[]     @relation("EventStaffUser")
  eventStaffInvitations   EventStaff[]     @relation("EventStaffInviter")
  institutionalAssignments InstitutionalAccountAssignment[]
  feedbacks               EventFeedback[]
}

model Club {
  id                   String           @id @db.VarChar(24)
  clubName             String           @unique
  slug                 String           @unique
  description          String?
  category             String?
  clubLogo             String?
  bannerImage          String?
  facultyCoordinatorId String?          @db.VarChar(24)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  clubEmail            String?
  facultyEmail         String?
  facultyName          String?
  studentCoordinators  String[]         @default([]) @map("studentcoordinators")
  motto                String?
  mission              String?
  establishedYear      String?
  account              ClubAccount?
  facultyCoordinator   AdminRole?       @relation("ClubFacultyCoordinator", fields: [facultyCoordinatorId], references: [id])
  memberships          ClubMembership[]
  socialLinks          ClubSocialLink[]
  events               Event[]
  media                Media[]
  sponsors             Sponsor[]
  participatingEvents  EventClub[]
  announcements        ClubAnnouncement[]
  achievements         ClubAchievement[]
}

model ClubAccount {
  id                  String         @id @db.VarChar(24)
  clubId              String         @unique @db.VarChar(24)
  email               String         @unique
  password            String
  isActive            Boolean        @default(true)
  resetPasswordToken  String?
  resetPasswordExpire DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  club              Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  notificationsSent Notification[] @relation("NotificationSenderClubAccount")

  @@index([email])
}

model ClubSocialLink {
  id       String @id @db.VarChar(24)
  clubId   String @db.VarChar(24)
  platform String
  url      String
  club     Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model ClubMembership {
  id                String         @id @db.VarChar(24)
  studentId         String         @db.VarChar(24)
  clubId            String         @db.VarChar(24)
  role              ClubMemberRole @default(MEMBER)
  academicSessionId String?        @db.VarChar(24)
  status            String         @default("ACTIVE")
  customPermissions String[]       @default([])
  canEditEvents     Boolean        @default(false)
  canTakeAttendance Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  club              Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  student           StudentUser    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([clubId, studentId])
  @@index([studentId])
  @@index([clubId, role])
}

model Event {
  id                   String          @id @db.VarChar(24)
  title                String
  slug                 String?         @unique
  description          String?
  venue                String
  startTime            DateTime
  endTime              DateTime
  totalSeats           Int             @default(0)
  entryFee             Float           @default(0)
  allowedPrograms      String[]        @default(["BTECH", "MTECH", "OTHER"])
  allowedYears         String[]        @default([])
  allowedBranches      String[]        @default([])
  imageUrl             String?
  registeredCount      Int             @default(0)
  views                Int             @default(0)
  waitingListIds       String[]        @default([])
  requiredFields       String[]        @default([])
  customFields         Json?
  createdById          String?         @db.VarChar(24)
  clubId               String?         @db.VarChar(24)
  organizerType        EventOrganizerType @default(CLUB)
  centralOrganizerId   String?         @db.VarChar(24)
  institutionalAccountId String?       @db.VarChar(24)
  registrationDeadline DateTime?
  reviewStatus         ReviewStatus    @default(PENDING)
  reviewComment        String?
  reviewedById         String?         @db.VarChar(24)
  winners              Json?
  showWinner           Boolean         @default(false)
  provideCertificate   Boolean         @default(false)
  certificateTemplate  Json?
  paymentMethod        String          @default("FREE")
  registrationFee      Float           @default(0)
  paymentInstructions  String?
  collegePaymentUrl    String?
  upiId                String?
  accountHolderName    String?
  postRegistrationMessage String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt
  isFeatured           Boolean         @default(false)
  allowExternal        Boolean         @default(true)
  feedbackEnabled      Boolean         @default(true)
  registrationType     String          @default("individual")
  minTeamSize          Int             @default(1)
  maxTeamSize          Int             @default(1)
  club                 Club?           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  centralOrganizer     StudentUser?    @relation("CentralOrganizerEvents", fields: [centralOrganizerId], references: [id])
  institutionalAccount InstitutionalAccount? @relation("InstitutionalEvents", fields: [institutionalAccountId], references: [id])
  createdBy            StudentUser?    @relation("EventCreatedBy", fields: [createdById], references: [id])
  reviewedBy           AdminRole?      @relation("EventReviewedBy", fields: [reviewedById], references: [id])
  media                Media[]
  participations       Participation[]
  sponsors             Sponsor[]
  teams                Team[]
  scannerSessions      ScannerSession[]
  attendanceRecords    AttendanceRecord[]
  eventStaff           EventStaff[]
  participatingClubs   EventClub[]
  feedbacks            EventFeedback[]
  aiReviews            EventAIReview[]

  @@index([clubId, startTime])
  @@index([reviewStatus, startTime])
  @@index([createdById, startTime])
  @@index([centralOrganizerId])
  @@index([institutionalAccountId])
  @@index([organizerType])
}

model ScannerSession {
  id        String    @id @db.VarChar(24)
  eventId   String    @db.VarChar(24)
  clubId    String?   @db.VarChar(24)
  userId    String    @db.VarChar(24)
  deviceId  String
  mode      String    // "ONLINE" | "OFFLINE"
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  status    String    @default("ACTIVE") // "ACTIVE" | "ENDED"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, deviceId, mode])
  @@index([eventId, status])
  @@index([userId])
}

model AttendanceRecord {
  id                String        @id @db.VarChar(24)
  eventId           String        @db.VarChar(24)
  participationId   String        @db.VarChar(24)
  scannerSessionId  String?       @db.VarChar(24)
  scannedAt         DateTime
  verificationMode  String        // "ONLINE" | "OFFLINE"
  syncedAt          DateTime?
  localAttendanceId String?       @unique // Client-generated UUID for idempotency
  createdAt         DateTime      @default(now())

  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([eventId, participationId]) // DB-level duplicate prevention
  @@index([eventId, scannedAt])
  @@index([scannerSessionId])
}


model Participation {
  id               String              @id @db.VarChar(24)
  eventId          String              @db.VarChar(24)
  studentId        String?             @db.VarChar(24)
  externalEmail    String?
  externalName     String?
  status           ParticipationStatus @default(REGISTERED)
  qrCode           String?             @unique
  qrVersion        Int?                // 1 = signed v1, null = legacy unsigned
  qrPayload        String?             // Full signed base64url payload for QR
  qrKeyId          String?             // Key ID used for signing (for rotation)
  attendedAt       DateTime?
  markedByMemberId String?             @db.VarChar(24)
  paymentStatus        PaymentStatus       @default(SUCCESS)
  amountPaid           Float               @default(0)
  paymentId            String?
  orderId              String?
  paymentTimestamp     DateTime?
  transactionId        String?
  payerName            String?
  paymentRemarks       String?
  paymentReviewedBy    String?
  paymentReviewedAt    DateTime?
  paymentReviewMessage String?
  formResponses        Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @default(now()) @updatedAt
  event            Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student          StudentUser?        @relation(fields: [studentId], references: [id])
  externalUserId   String?             @db.VarChar(24)
  externalUser     ExternalUser?       @relation(fields: [externalUserId], references: [id], onDelete: Cascade)
  teamId           String?             @db.VarChar(24)
  team             Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]

  @@index([eventId])
  @@index([studentId, createdAt])
  @@index([studentId, eventId])
  @@index([externalUserId])
  @@index([externalEmail])
  @@index([eventId, paymentStatus])
  @@index([eventId, status])
}


model Sponsor {
  id         String  @id @db.VarChar(24)
  name       String
  logoUrl    String
  websiteUrl String?
  clubId     String? @db.VarChar(24)
  eventId    String? @db.VarChar(24)
  club       Club?   @relation(fields: [clubId], references: [id])
  event      Event?  @relation(fields: [eventId], references: [id])

  @@index([clubId])
  @@index([eventId])
}

model Media {
  id         String    @id @db.VarChar(24)
  url        String
  type       MediaType @default(IMAGE)
  caption    String?
  albumTitle String?   @default("General")
  clubId     String?   @db.VarChar(24)
  eventId    String?   @db.VarChar(24)
  club       Club?     @relation(fields: [clubId], references: [id])
  event      Event?    @relation(fields: [eventId], references: [id])

  @@index([clubId])
  @@index([eventId])
}

model Notification {
  id                            String                @id @db.VarChar(24)
  senderStudentId               String?               @db.VarChar(24)
  senderAdminId                 String?               @db.VarChar(24)
  senderInstitutionalAccountId  String?               @db.VarChar(24)
  senderClubAccountId           String?               @db.VarChar(24)
  recipientStudentId            String?               @db.VarChar(24)
  lostFoundItemId               String?               @db.VarChar(24)
  eventId                       String?               @db.VarChar(24)
  teamId                        String?               @db.VarChar(24)
  type                          String?
  title                         String
  message                       String
  createdAt                     DateTime              @default(now())
  readBy                        String[]              @default([])
  senderAdmin                   AdminRole?            @relation("NotificationSenderAdmin", fields: [senderAdminId], references: [id])
  senderStudent                 StudentUser?          @relation("NotificationSenderStudent", fields: [senderStudentId], references: [id])
  senderInstitutionalAccount    InstitutionalAccount? @relation("NotificationSenderInstitutionalAccount", fields: [senderInstitutionalAccountId], references: [id])
  senderClubAccount             ClubAccount?          @relation("NotificationSenderClubAccount", fields: [senderClubAccountId], references: [id])
  recipientStudent              StudentUser?          @relation("NotificationRecipientStudent", fields: [recipientStudentId], references: [id])
  lostFoundItem                 LostFoundItem?        @relation(fields: [lostFoundItemId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([recipientStudentId, createdAt])
  @@index([eventId, createdAt])
  @@index([teamId, createdAt])
}

model PushSubscription {
  id         String   @id @db.VarChar(24)
  userId     String   @db.VarChar(24)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

enum AdminRoleType {
  admin
  facultyCoordinator
  paymentAdmin
  lostFoundAdmin
}

enum EventOrganizerType {
  CLUB
  CENTRAL
}

enum EventStaffStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
  EXPIRED
}

enum ClubMemberRole {
  CLUB_HEAD
  COORDINATOR
  MEMBER
}

enum EventMode {
  online
  offline
}

enum ParticipationStatus {
  REGISTERED
  ATTENDED
  WAITLISTED
  CANCELLED
  INVITED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  APPROVED
  REJECTED
  NEED_MORE_DETAILS
}

enum ReviewStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  DELETION_REQUESTED
}

enum MediaType {
  IMAGE
  VIDEO
  SPONSOR_LOGO
}

model LostFoundItem {
  id             String            @id @db.VarChar(24)
  title          String
  description    String
  type           LostFoundType     @default(LOST)
  imageUrl       String?
  imagePublicId  String?
  whatsapp       String?
  status         LostFoundStatus   @default(ACTIVE)
  isFraud        Boolean           @default(false)
  reportedBy     String[]          @default([])
  userId         String            @db.VarChar(24)
  user           StudentUser       @relation(fields: [userId], references: [id])
  reports        LostFoundReport[]
  notifications  Notification[]
  reunitedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([isFraud, createdAt])
}

model LostFoundReport {
  id         String        @id @db.VarChar(24)
  itemId     String        @db.VarChar(24)
  item       LostFoundItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reporterId String        @db.VarChar(24)
  reporter   StudentUser   @relation("ReportReporter", fields: [reporterId], references: [id])
  liarId     String        @db.VarChar(24)
  liar       StudentUser   @relation("ReportLiar", fields: [liarId], references: [id])
  reason     String?
  createdAt  DateTime      @default(now())

  @@index([itemId, createdAt])
  @@index([reporterId])
  @@index([liarId])
}

enum LostFoundType {
  LOST
  FOUND
}

enum LostFoundStatus {
  ACTIVE
  REUNITED
}

model Team {
  id               String          @id @db.VarChar(24)
  eventId          String          @db.VarChar(24)
  teamName         String
  leaderId         String          @db.VarChar(24)
  leaderStudentId  String?         @db.VarChar(24)
  leaderExternalId String?         @db.VarChar(24)
  status           String          @default("active")
  createdAt        DateTime        @default(now())
  event            Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leader           StudentUser?    @relation("TeamLeader", fields: [leaderStudentId], references: [id], onDelete: Cascade)
  leaderExternal   ExternalUser?   @relation("ExternalTeamLeader", fields: [leaderExternalId], references: [id], onDelete: Cascade)
  members          TeamMember[]
  participations   Participation[]

  @@index([eventId])
  @@index([leaderId])
  @@index([leaderStudentId])
  @@index([leaderExternalId])
}

model TeamMember {
  id             String        @id @db.VarChar(24)
  teamId         String        @db.VarChar(24)
  userId         String        @db.VarChar(24)
  studentId      String?       @db.VarChar(24)
  externalUserId String?       @db.VarChar(24)
  role           String        @default("member")
  joinedAt       DateTime      @default(now())
  team           Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           StudentUser?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  externalUser   ExternalUser? @relation(fields: [externalUserId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([studentId])
  @@index([externalUserId])
}

model Permission {
  id          String           @id
  name        String           @unique
  description String?
  resource    String
  action      String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id
  role         String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

model ExportLog {
  id          String   @id @db.VarChar(24)
  dataset     String
  recordCount Int      @default(0)
  actorId     String   @db.VarChar(24)
  actorEmail  String
  actorRole   String
  filters     Json?
  columns     String[] @default([])
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([dataset, createdAt])
}

model Venue {
  id        String   @id @db.VarChar(24)
  name      String   @unique
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now()) @updatedAt
  updatedAt DateTime @default(now()) @updatedAt
}

model VenueBlackout {
  id          String   @id @db.VarChar(24)
  venue       String
  title       String
  reason      String?
  startTime   DateTime
  endTime     DateTime
  createdById String?  @db.VarChar(24)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([venue, startTime])
  @@index([startTime, endTime])
}

model EventStaff {
  id          String           @id @db.VarChar(24)
  eventId     String           @db.VarChar(24)
  userId      String           @db.VarChar(24)
  invitedById String?          @db.VarChar(24)
  permissions String[]         @default([])
  status      EventStaffStatus @default(PENDING)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        StudentUser      @relation("EventStaffUser", fields: [userId], references: [id])
  invitedBy   StudentUser?     @relation("EventStaffInviter", fields: [invitedById], references: [id])

  @@unique([eventId, userId])
  @@index([userId, status])
  @@index([eventId, status])
}

model EventClub {
  id      String @id @db.VarChar(24)
  eventId String @db.VarChar(24)
  clubId  String @db.VarChar(24)

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  club    Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([eventId, clubId])
  @@index([eventId])
  @@index([clubId])
}

model AuditLog {
  id         String   @id @db.VarChar(24)
  action     String
  actorType  String?
  actorId    String   @db.VarChar(24)
  actorEmail String
  targetId   String?  @db.VarChar(24)
  clubId     String?  @db.VarChar(24)
  eventId    String?  @db.VarChar(24)
  metadata   Json?
  source     String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([clubId, createdAt])
  @@index([eventId, createdAt])
  @@index([action, createdAt])
}

model ClubAnnouncement {
  id          String   @id @db.VarChar(24)
  clubId      String   @db.VarChar(24)
  title       String
  content     String
  isPinned    Boolean  @default(false)
  isPublished Boolean  @default(true)
  authorName  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, isPublished])
  @@index([clubId, isPinned])
}

model ClubAchievement {
  id          String   @id @db.VarChar(24)
  clubId      String   @db.VarChar(24)
  title       String
  description String?
  date        String?
  imageUrl    String?
  externalUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
}

enum InstitutionalAccountType {
  DSW
}

enum InstitutionalRole {
  CENTRAL_EVENT_ORGANISER
  EVENT_COORDINATOR
  ATTENDANCE_COORDINATOR
  PAYMENT_COORDINATOR
  MEMBER
}

model InstitutionalAccount {
  id                  String                           @id @db.VarChar(24)
  name                String
  type                InstitutionalAccountType         @default(DSW)
  email               String?                          @unique
  password            String?
  resetPasswordToken  String?
  resetPasswordExpire DateTime?
  isActive            Boolean                          @default(true)
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  assignments       InstitutionalAccountAssignment[]
  events            Event[]                          @relation("InstitutionalEvents")
  notificationsSent Notification[]                   @relation("NotificationSenderInstitutionalAccount")

  @@index([type, isActive])
}

model InstitutionalAccountAssignment {
  id                     String               @id @db.VarChar(24)
  institutionalAccountId String               @db.VarChar(24)
  studentId              String               @db.VarChar(24)
  role                   InstitutionalRole    @default(CENTRAL_EVENT_ORGANISER)
  academicSessionId      String?              @db.VarChar(24)
  status                 String               @default("ACTIVE")
  customPermissions      String[]             @default([])
  canManageEvents        Boolean              @default(true)
  canTakeAttendance      Boolean              @default(true)
  canVerifyPayments      Boolean              @default(false)
  canDelegateStaff       Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  institutionalAccount   InstitutionalAccount @relation(fields: [institutionalAccountId], references: [id], onDelete: Cascade)
  student                StudentUser          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([institutionalAccountId, studentId])
  @@index([studentId, status])
  @@index([institutionalAccountId, status])
  @@index([institutionalAccountId, role])
}

enum AttendSimilar {
  YES
  MAYBE
  NO
}

model EventFeedback {
  id                  String        @id @db.VarChar(24)
  eventId             String        @db.VarChar(24)
  userId              String        @db.VarChar(24)

  overallRating       Int
  organizationRating  Int
  usefulnessRating    Int
  speakerRating       Int
  venueRating         Int
  timingRating        Int

  attendSimilar       AttendSimilar

  liked               String?
  improvements        String?
  comments            String?

  submittedAt         DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  event               Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                StudentUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, submittedAt])
  @@index([userId, submittedAt])
}

model EventAIReview {
  id                     String        @id @db.VarChar(24)
  eventId                String        @db.VarChar(24)
  reviewNumber           Int           // 1 or 2
  status                 String        // "COMPLETED" | "FAILED" | "IN_PROGRESS"
  responseCount          Int
  attendeeCount          Int
  overallSentiment       String        // "very_positive" | "positive" | "mixed" | "negative" | "very_negative" | "insufficient_data"
  overallSummary         String        @db.Text
  whatStudentsLiked      Json          // Array<{ theme: string, summary: string, evidenceCount?: number }>
  improvementAreas       Json          // Array<{ theme: string, summary: string, evidenceCount?: number, priority: "high" | "medium" | "low" }>
  keyTakeaways           Json          // string[] (3-5 takeaways)
  recommendations        Json          // Array<{ title: string, description: string, priority: string, evidenceCount?: number }>
  positiveHighlights     Json          // Array<{ quote: string, reason: string }>
  constructiveHighlights Json          // Array<{ quote: string, reason: string }>
  attendAgainSummary     Json?         // { yesPercentage: number, maybePercentage: number, noPercentage: number }
  model                  String
  generatedById          String?       @db.VarChar(24)
  generatedAt            DateTime      @default(now())
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  event                  Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, reviewNumber])
  @@index([eventId, status])
  @@index([eventId, generatedAt])
}

model ExternalUser {
  id                  String          @id @db.VarChar(24)
  name                String
  email               String          @unique
  password            String
  collegeName         String
  phone               String?
  program             String?
  graduationYear      Int?
  profileImage        String?
  githubProfile       String?
  linkedinProfile     String?
  xProfile            String?
  instagramProfile    String?
  whatsappNumber      String?
  portfolioUrl        String?
  isVerified          Boolean         @default(true)
  isTwoStepEnabled    Boolean         @default(false)
  otp                 String?
  otpExpire           DateTime?
  resetPasswordExpire DateTime?
  resetPasswordToken  String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  participations      Participation[]
  ledTeams            Team[]          @relation("ExternalTeamLeader")
  teamMemberships     TeamMember[]

  @@index([email])
}

