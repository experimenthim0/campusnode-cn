# ==============================================================================
# CampusNode Server Environment Template (.env.example)
# ==============================================================================
# Copy this file to server/.env for local development.
# For Render / Cloud deployments, configure these variables in the Environment Settings dashboard.
#
# RULE 1: Staging and Local development must use the STAGING database.
# RULE 2: Production must use the PRODUCTION database.
# RULE 3: Never copy production secrets into staging or local environments.
# ==============================================================================

# ------------------------------------------------------------------------------
# TIER 1: CRITICAL SECRETS — MUST BE COMPLETELY DIFFERENT BETWEEN STAGING & PRODUCTION
# ------------------------------------------------------------------------------

# PostgreSQL Connection String (Pooler URL recommended with sslmode=require)
# STAGING & LOCAL: <STAGING_DATABASE_URL>
# PRODUCTION     : <PRODUCTION_DATABASE_URL>
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# JWT Secret for session tokens (Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="<SECURE_RANDOM_64_BYTE_HEX_STRING>"

# Ed25519 QR Ticket Digital Signing Key Pair (Generate using: node scripts/generate-staging-secrets.js)
# Production Key ID: cn-qr-2026-01 | Staging Key ID: cn-qr-staging-2026-01
QR_SIGNING_KEY_ID="cn-qr-staging-2026-01"
QR_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<STAGING_ED25519_PRIVATE_KEY_PEM>\n-----END PRIVATE KEY-----"
QR_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<STAGING_ED25519_PUBLIC_KEY_PEM>\n-----END PUBLIC KEY-----"

# Web Push VAPID Key Pair (Generate using: node scripts/generate-staging-secrets.js)
VAPID_PUBLIC_KEY="<STAGING_VAPID_PUBLIC_KEY_BASE64URL>"
VAPID_PRIVATE_KEY="<STAGING_VAPID_PRIVATE_KEY_BASE64URL>"
VAPID_SUBJECT="mailto:admin@campusnode.in"

# Administrator & Institutional Initial Passwords
ADMIN_EMAIL="admin@campusnode.in"
ADMIN_PASS="<STAGING_ADMIN_PASSWORD>"
COMMON_PASSWORD="<STAGING_COMMON_PASSWORD>"

# ------------------------------------------------------------------------------
# TIER 2: INTEGRATIONS — SHOULD PREFERABLY BE SEPARATE CREDENTIALS
# ------------------------------------------------------------------------------

# Transactional Email via Resend
# Leave empty in local dev to automatically use MockTransport (safe fallback)
RESEND_API_KEY="re_<API_KEY>"
EMAIL_FROM="CampusNode <onboarding@resend.dev>"
EMAIL_FROM_NAME="CampusNode Support"

# Legacy SMTP Password (if using Nodemailer fallback, otherwise unused)
EMAIL_PASS=""

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="<CLOUDINARY_CLOUD_NAME>"
CLOUDINARY_API_KEY="<CLOUDINARY_API_KEY>"
CLOUDINARY_API_SECRET="<CLOUDINARY_API_SECRET>"
# Folder prefix for asset isolation when sharing a single Cloudinary account:
# Staging: campusnode/staging | Production: campusnode/production
CLOUDINARY_FOLDER_PREFIX="campusnode/staging"

# OpenRouter AI Analysis Service
OPENROUTER_API_KEY="sk-or-v1-<API_KEY>"
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_SITE_URL="http://localhost:5173"
OPENROUTER_SITE_NAME="CampusNode Dev"

# Redis & BullMQ Queue Configuration
# For local development: redis://127.0.0.1:6379 (or leave empty to use in-memory fallback)
REDIS_URL="redis://127.0.0.1:6379"

# ------------------------------------------------------------------------------
# TIER 3: RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------

# Server Port (Default: 5001 or 5000)
PORT=5001

# Allowed Frontend Client Origin for CORS & Magic Links
# Local      : http://localhost:5173
# Staging    : https://<staging-app>.vercel.app
# Production : https://campusnode.vercel.app
CLIENT_URL="http://localhost:5173"
# Optional comma-separated additional origins. Do not use a wildcard in production.
ALLOWED_ORIGINS="http://localhost:5173"

# Verification Bypass (Strictly false in production; can be true only for automated test runs)
SKIP_VERIFICATION=false

# Maintenance Mode Gate
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="CampusNode backend is currently undergoing scheduled maintenance."

# Observability Request Log Tuning
# During local development against a cloud database (e.g. Neon in Singapore), roundtrip
# network latency (~150-300ms/query) will make requests exceed the 300ms threshold.
# Increase SLOW_REQUEST_MS (e.g. 1500 or 2000) or set ENABLE_REQUEST_METRICS_LOG=false to silence console spam.
SLOW_REQUEST_MS=300
ENABLE_REQUEST_METRICS_LOG=true

# ------------------------------------------------------------------------------
# TIER 4: OPENTELEMETRY & GRAFANA CLOUD MONITORING
# ------------------------------------------------------------------------------
# Enable/Disable OpenTelemetry (Set to "true" in Staging & Production, "false" in local)
OTEL_ENABLED=false

# Service Identity (Must be distinct between staging and production)
# Staging: campusnode-api-staging | Production: campusnode-api
OTEL_SERVICE_NAME="campusnode-api-staging"

# Resource Attributes (Key-value pairs separated by commas)
# Staging: deployment.environment=staging,service.version=1.3.0
# Production: deployment.environment=production,service.version=1.3.0
OTEL_RESOURCE_ATTRIBUTES="deployment.environment=staging,service.version=1.3.0"

# Grafana Cloud OTLP HTTP Gateway Endpoint
# Example: https://otlp-gateway-prod-us-east-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=""

# Grafana Cloud Basic Auth Header (Never commit this value!)
# Generate in Grafana Cloud: Base64(InstanceID:Token)
# Format: Authorization=Basic <BASE64_TOKEN>
OTEL_EXPORTER_OTLP_HEADERS=""

# Sampling Strategy
# Staging: 1.0 (100% of traces) | Production: 0.25 (25% adaptive sampling)
OTEL_TRACES_SAMPLER="parentbased_traceidratio"
OTEL_TRACES_SAMPLER_ARG=1.0

# Metric Export Interval (Milliseconds)
OTEL_METRICS_INTERVAL_MS=15000
