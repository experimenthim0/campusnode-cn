{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|avif|gif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/events/:slug",
      "has": [
        {
          "type": "header",
          "key": "User-Agent",
          "value": "(?i)(whatsapp|facebookexternalhit|facebot|linkedinbot|twitterbot|telegrambot|slackbot|discordbot|applebot|skypeuripreview|redditbot|googlebot|pinterest|outbrain|vkshare|viber|snapchat|meta-externalagent|curl)"
        }
      ],
      "destination": "/api/preview?slug=:slug"
    },
    {
      "source": "/event/:slug",
      "has": [
        {
          "type": "header",
          "key": "User-Agent",
          "value": "(?i)(whatsapp|facebookexternalhit|facebot|linkedinbot|twitterbot|telegrambot|slackbot|discordbot|applebot|skypeuripreview|redditbot|googlebot|pinterest|outbrain|vkshare|viber|snapchat|meta-externalagent|curl)"
        }
      ],
      "destination": "/api/preview?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}