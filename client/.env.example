# ==============================================================================
# CampusNode Client Environment Template (.env.example)
# ==============================================================================
# Copy this file to client/.env for local development.
# For Vercel deployments, configure these variables in the Vercel Project Settings.
#
# ENVIRONMENT TARGETS:
# - Local Dev (develop branch) : VITE_API_URL=http://localhost:5001
#

# Backend API Base URL (Must NEVER point to production backend during local/staging development)
VITE_API_URL=http://localhost:5001

# Google Apps Script Web App URL for contact/feedback form integration
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/<SCRIPT_ID>/exec

# Maintenance Mode Override (true | false)
VITE_MAINTENANCE_MODE=false
