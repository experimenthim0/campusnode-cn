# ==============================================================================
# CampusNode Client Environment Template (.env.example)
# ==============================================================================
# Copy this file to client/.env for local development.
# For Vercel deployments, configure these variables in the Vercel Project Settings.
#
# ENVIRONMENT TARGETS:
# - Local Dev (with Vite proxy): VITE_API_URL= (empty string, proxies /api and /socket.io to http://localhost:5000)
# - Production (behind Nginx)  : VITE_API_URL= (empty string, same-origin relative requests)
# - Direct standalone backend  : VITE_API_URL=http://localhost:5000 (only if proxy is bypassed)
#

# Backend API Base URL (leave empty for relative same-origin routing via Vite proxy or Nginx)
VITE_API_URL=

# Google Apps Script Web App URL for contact/feedback form integration
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/<SCRIPT_ID>/exec

# Dev Community link (Telegram)
VITE_DEV_COMMUNITY_URL=https://t.me/+lWss-PdCbGQ0ZDNl

# Maintenance Mode Override (true | false)
VITE_MAINTENANCE_MODE=false
